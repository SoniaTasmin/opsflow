{"openapi":"3.1.0","info":{"title":"OpsFlow API","description":"Reporting, approval and bulk-import platform.\n\nAll errors share one shape (RFC 9457, media type\napplication/problem+json) and carry a stable \"code\" plus the\nrequest's \"correlationId\". Clients switch on \"code\"; \"title\" and\n\"detail\" are human-readable and may be reworded at any time.\n","license":{"name":"MIT","url":"https://opensource.org/licenses/MIT"},"version":"v1"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"tags":[{"name":"Reporting periods","description":"Reporting periods and their scope"},{"name":"Metrics","description":"The metric catalogue"},{"name":"Identity","description":"The authenticated user"},{"name":"Organizations","description":"Organizations and their membership"},{"name":"Users","description":"Provisioned users"}],"paths":{"/api/v1/periods/{id}/organizations":{"put":{"tags":["Reporting periods"],"summary":"Set the participating organizations","description":"Draft periods only; participation freezes on open.","operationId":"setPeriodParticipants","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SetParticipantsRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PeriodResponse"}}}}}}},"/api/v1/periods/{id}/metrics":{"put":{"tags":["Reporting periods"],"summary":"Set the metric scope","description":"Draft periods only; the scope freezes on open.","operationId":"setPeriodMetricScope","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SetMetricScopeRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Peri