{
  "realm": "opsflow",
  "enabled": true,
  "displayName": "OpsFlow",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "May work with the organizations they belong to"
      },
      {
        "name": "REVIEWER",
        "description": "Central reviewer: review authority across all organizations"
      },
      {
        "name": "ADMIN",
        "description": "Platform administration"
      }
    ]
  },
  "clients": [
    {
      "clientId": "opsflow-frontend",
      "name": "OpsFlow web application",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "protocolMappers": [
        {
          "name": "opsflow-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "opsflow-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "opsflow-api",
      "name": "OpsFlow API",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "opsflow-dev-cli",
      "name": "LOCAL DEVELOPMENT ONLY - password grant for obtaining tokens with curl",
      "description": "Not part of the deployed realm. Exists so a developer or an integration test can obtain a token without a browser.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "opsflow-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "opsflow-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "opsflow-wrong-audience-cli",
      "name": "LOCAL DEVELOPMENT ONLY - issues tokens WITHOUT the opsflow-api audience",
      "description": "Exists so an integration test can prove that a validly signed token from this realm is still rejected when it was not issued for this API. Deliberately has no audience mapper.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "reporter",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ria",
      "lastName": "Reporter",
      "email": "reporter@opsflow.local",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER"
      ]
    },
    {
      "username": "reviewer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Rex",
      "lastName": "Reviewer",
      "email": "reviewer@opsflow.local",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER",
        "REVIEWER"
      ]
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "email": "admin@opsflow.local",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER",
        "ADMIN"
      ]
    },
    {
      "username": "noroles",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Nora",
      "lastName": "Noroles",
      "email": "noroles@opsflow.local",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": []
    }
  ]
}
