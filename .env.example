# Copy to .env and adjust. .env is git-ignored and must never be committed.
#
# These are LOCAL DEVELOPMENT values only. Deployed environments supply every
# one of these through the environment; nothing here is a production default.

# --- PostgreSQL ---
POSTGRES_USER=opsflow
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=opsflow
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local

# --- Keycloak (local development only) ---
# Bootstrap admin for the local container's admin console. Not a deployed credential:
# a real instance is provisioned out of band and never from a file in the repository.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8081
